# Copy to .env (gitignored) and fill in. The Express server reads this and
# hands the Decart key to the frontend at runtime via GET /api/config — but
# only when the request carries ?key=<ACCESS_KEY>, which the app forwards
# from its own ?key= URL param.
DECART_API_KEY=dct_your_key_here
ACCESS_KEY=generate_a_random_string_here
